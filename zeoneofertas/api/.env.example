# Configurações do MySQL (Docker)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ofertahub
MYSQL_USER=ofertahub_user
MYSQL_PASSWORD=ofertahub_pass
MYSQL_PORT=3307

# URL de Conexão Prisma ORM (Root com permissões para Shadow Database)
DATABASE_URL="mysql://root:rootpassword@localhost:3307/ofertahub"

# Autenticação JWT
JWT_SECRET=super-secret-ofertahub-jwt-key-2026
JWT_EXPIRES_IN=7d

# Porta da API
PORT=3001

# Mercado Livre OAuth Access Token
MERCADO_LIVRE_ACCESS_TOKEN=seu_access_token_aqui
