datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MarketplaceType {
  MERCADO_LIVRE
  SHOPEE
  MANUAL
  AMAZON
  MAGALU
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum OfferStatus {
  FOUND
  IN_ANALYSIS
  APPROVED
  WAITING_AFFILIATE_LINK
  READY_TO_SHARE
  PUBLISHED
  EXPIRED
  IGNORED
}

enum AffiliateLinkStatus {
  PENDING
  CONFIGURED
  VALIDATED
  ERROR
  EXPIRED
}

enum CouponStatus {
  DRAFT
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  UNVERIFIED
}

enum SocialNetwork {
  WHATSAPP
  INSTAGRAM
  STORIES
  TELEGRAM
  FACEBOOK
  X
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELLED
  ERROR
}

model Profile {
  id                String              @id @default(uuid())
  name              String
  email             String              @unique
  passwordHash      String
  avatarUrl         String?
  createdAt         DateTime            @default(now())
  
  ownedWorkspaces   Workspace[]         @relation("WorkspaceOwner")
  memberships       WorkspaceMember[]
  responsibleOffers SavedOffer[]        @relation("ResponsibleUser")
  publications      SocialPublication[]

  @@map("profiles")
}

model Workspace {
  id            String                  @id @default(uuid())
  name          String
  slug          String                  @unique
  logoUrl       String?
  ownerId       String
  createdAt     DateTime                @default(now())

  owner         Profile                 @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  connections   MarketplaceConnection[]
  categories    Category[]
  searchSources SearchSource[]
  savedOffers   SavedOffer[]
  coupons       Coupon[]
  templates     SocialTemplate[]
  publications  SocialPublication[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model MarketplaceConnection {
  id                    String          @id @default(uuid())
  workspaceId           String
  marketplace           MarketplaceType
  status                String          @default("CONNECTED")
  accessTokenEncrypted  String?         @db.Text
  refreshTokenEncrypted String?         @db.Text
  expiresAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  workspace             Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("marketplace_connections")
}

model Category {
  id            String         @id @default(uuid())
  workspaceId   String
  name          String
  slug          String
  imageUrl      String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searchSources SearchSource[]

  @@map("categories")
}

model SearchSource {
  id                 String          @id @default(uuid())
  workspaceId        String
  marketplace        MarketplaceType
  categoryId         String?
  keyword            String
  externalCategoryId String?
  externalDomainId   String?
  minimumDiscount    Decimal         @default(0.00) @db.Decimal(5, 2)
  active             Boolean         @default(true)
  lastRunAt          DateTime?
  createdAt          DateTime        @default(now())

  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category           Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("search_sources")
}

model CatalogProduct {
  id               String             @id @default(uuid())
  marketplace      MarketplaceType
  externalId       String
  catalogProductId String?
  domainId         String?
  title            String
  description      String?            @db.Text
  brand            String?
  model            String?
  imageUrl         String
  images           Json?
  attributes       Json?
  status           String             @default("ACTIVE")
  lastSyncedAt     DateTime           @default(now())

  offers           MarketplaceOffer[]

  @@unique([marketplace, externalId])
  @@map("catalog_products")
}

model MarketplaceOffer {
  id                 String           @id @default(uuid())
  catalogProductId   String?
  marketplace        MarketplaceType
  externalItemId     String
  sellerId           String?
  sellerName         String?
  price              Decimal          @db.Decimal(10, 2)
  originalPrice      Decimal?         @db.Decimal(10, 2)
  discountPercentage Decimal          @default(0.00) @db.Decimal(5, 2)
  currency           String           @default("BRL") @db.VarChar(3)
  availableQuantity  Int              @default(0)
  soldQuantity       Int              @default(0)
  freeShipping       Boolean          @default(false)
  productUrl         String           @db.Text
  status             String           @default("AVAILABLE")
  lastSyncedAt       DateTime         @default(now())

  catalogProduct     CatalogProduct?  @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  savedOffers        SavedOffer[]
  priceHistories     PriceHistory[]

  @@unique([marketplace, externalItemId])
  @@map("marketplace_offers")
}

model SavedOffer {
  id                 String              @id @default(uuid())
  workspaceId        String
  marketplaceOfferId String
  status             OfferStatus         @default(FOUND)
  score              Int                 @default(50)
  notes              String?             @db.Text
  responsibleUserId  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplaceOffer   MarketplaceOffer    @relation(fields: [marketplaceOfferId], references: [id], onDelete: Cascade)
  responsibleUser    Profile?            @relation("ResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  affiliateLinks     AffiliateLink[]
  couponOffers       CouponOffer[]
  publications       SocialPublication[]

  @@map("saved_offers")
}

model AffiliateLink {
  id              String              @id @default(uuid())
  savedOfferId    String
  originalUrl     String              @db.Text
  affiliateUrl    String?             @db.Text
  trackingTag     String?
  status          AffiliateLinkStatus @default(PENDING)
  lastValidatedAt DateTime?
  clickCount      Int                 @default(0)
  createdAt       DateTime            @default(now())

  savedOffer      SavedOffer          @relation(fields: [savedOfferId], references: [id], onDelete: Cascade)
  clickEvents     ClickEvent[]

  @@map("affiliate_links")
}

model Coupon {
  id              String          @id @default(uuid())
  workspaceId     String
  marketplace     MarketplaceType
  code            String
  title           String
  description     String?         @db.Text
  discountType    String          @default("PERCENTAGE")
  discountValue   Decimal         @db.Decimal(10, 2)
  minimumPurchase Decimal         @default(0.00) @db.Decimal(10, 2)
  maximumDiscount Decimal?        @db.Decimal(10, 2)
  startsAt        DateTime?
  expiresAt       DateTime?
  source          String          @default("MANUAL")
  status          CouponStatus    @default(ACTIVE)
  rules           String?         @db.Text
  officialUrl     String?         @db.Text
  createdAt       DateTime        @default(now())

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  couponOffers    CouponOffer[]

  @@map("coupons")
}

model CouponOffer {
  id           String     @id @default(uuid())
  couponId     String
  savedOfferId String

  coupon       Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  savedOffer   SavedOffer @relation(fields: [savedOfferId], references: [id], onDelete: Cascade)

  @@unique([couponId, savedOfferId])
  @@map("coupon_offers")
}

model SocialTemplate {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  network     SocialNetwork
  content     String        @db.Text
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("social_templates")
}

model SocialPublication {
  id                String            @id @default(uuid())
  workspaceId       String
  savedOfferId      String
  network           SocialNetwork
  content           String            @db.Text
  affiliateUrl      String?           @db.Text
  status            PublicationStatus @default(DRAFT)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  responsibleUserId String?
  createdAt         DateTime          @default(now())

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  savedOffer        SavedOffer        @relation(fields: [savedOfferId], references: [id], onDelete: Cascade)
  responsibleUser   Profile?          @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@map("social_publications")
}

model PriceHistory {
  id                 String           @id @default(uuid())
  marketplaceOfferId String
  price              Decimal          @db.Decimal(10, 2)
  originalPrice      Decimal?         @db.Decimal(10, 2)
  collectedAt        DateTime         @default(now())

  marketplaceOffer   MarketplaceOffer @relation(fields: [marketplaceOfferId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model ClickEvent {
  id              String        @id @default(uuid())
  affiliateLinkId String
  source          String        @default("DIRECT")
  createdAt       DateTime      @default(now())

  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  @@map("click_events")
}
